NEXT_PUBLIC_RADIUS= # in kilometers
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY= # Midtrans Client Key for Snap.js
NEXT_PUBLIC_MIDTRANS_SERVER_KEY= # Midtrans Server Key for Snap.js

